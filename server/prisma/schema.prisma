generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  apiKey        String?
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now())

  conversations Conversation[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id           String    @id @default(uuid())
  title        String    @default("新对话")
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shareToken   String?   @unique
  isShared     Boolean   @default(false)
  sharedAt     DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, isPinned, pinnedAt(sort: Desc)])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  seq            Int      @default(autoincrement()) @unique
  role           String
  content        String   @db.Text
  thinking       String?  @db.Text
  toolCalls      Json?
  toolResults    Json?
  attachments    Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model McpServer {
  id        String   @id @default(uuid())
  name      String   @unique // ^[a-zA-Z0-9_-]{1,32}$ enforced in DTO
  transport String // "stdio" | "http"
  command   String? // stdio
  args      Json? // stdio: string[]
  url       String? // http
  headers   Json? // http: Record<string,string>
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id                String   @id @default("singleton")
  enableVoiceInput  Boolean  @default(true)
  enableWebSearch   Boolean  @default(true)
  enableTts         Boolean  @default(true)
  allowRegistration Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  baseUrl   String
  apiKey    String   @db.Text
  isEnabled Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]

  @@index([isDefault])
}

model Model {
  id          String   @id @default(uuid())
  providerId  String
  modelId     String
  displayName String
  type        String   @default("chat") // reserved: chat (future: image etc.)
  isEnabled   Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@index([type, isDefault])
}
